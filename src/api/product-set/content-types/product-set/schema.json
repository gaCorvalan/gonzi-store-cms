{
  "kind": "collectionType",
  "collectionName": "product_sets",
  "info": {
    "singularName": "product-set",
    "pluralName": "product-sets",
    "displayName": "Product set"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "required": true
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "product_sets"
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "product_sets"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "text"
    }
  }
}

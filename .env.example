# Copiá este archivo a .env. Los valores de abajo son placeholders para
# desarrollo local. No pongas secretos reales.

# --- Servidor (config/server.ts) ---
HOST=0.0.0.0
PORT=1337
# Lista separada por comas. Strapi no arranca si falta.
APP_KEYS=toBeModified1,toBeModified2

# --- Admin y cifrado (config/admin.ts) ---
# En local estos placeholders alcanzan. Antes de publicar, reemplazalos
# por cadenas largas y aleatorias.
ADMIN_JWT_SECRET=tobemodified
API_TOKEN_SALT=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
ENCRYPTION_KEY=tobemodified
# Opcionales. Si no los definís, quedan en true.
# FLAG_NPS=true
# FLAG_PROMOTE_EE=true

# --- API de usuarios (plugin users-permissions) ---
# No está en config/, pero el plugin lo lee al arrancar.
JWT_SECRET=tobemodified

# --- Base de datos (config/database.ts) ---
# Local, por defecto: sqlite. El archivo queda en .tmp/data.db
# (relativo a la raíz del proyecto cuando Strapi corre desde dist/).
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres, para producción. Dejá esto comentado en local.
# Poné DATABASE_CLIENT=postgres y completá la conexión.
# pg ya es dependencia del proyecto; no hace falta instalarlo a mano.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://usuario:clave@localhost:5432/strapi
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SCHEMA=public
# DATABASE_SSL=false
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# También las lee el cliente mysql de config/database.ts (puerto por
# defecto 3306). Este proyecto no usa MySQL.
# DATABASE_CONNECTION_TIMEOUT=60000

# --- Imágenes (config/plugins.ts, proveedor Cloudinary) ---
# Podés dejarlas vacías para abrir el admin. Subir archivos falla
# hasta que completes una cuenta de Cloudinary.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
